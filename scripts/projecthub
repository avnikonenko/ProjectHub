#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
project_root="$(cd "$(dirname "$script_path")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: projecthub [command]

Commands:
  start    Start ProjectHub (default)
  check    Run the project checks
  setup    Install or refresh local dependencies
  projects List local project IDs and names
  note     Add an AI note (run "projecthub note add --help")
  help     Show this help

Environment:
  PROJECTHUB_PORT       Loopback port (default: 8766)
  PROJECTHUB_DATA_DIR   Absolute application data directory
EOF
}

command_name="${1:-start}"

case "$command_name" in
  projects|note)
    if [[ ! -x "$project_root/.venv/bin/python" ]]; then
      echo "projecthub: run 'projecthub setup' first" >&2
      exit 1
    fi
    exec "$project_root/.venv/bin/python" "$project_root/scripts/notes_cli.py" "$@"
    ;;
  start)
    cd "$project_root"
    if [[ $# -gt 1 ]]; then
      echo "projecthub: start does not accept arguments" >&2
      exit 2
    fi
    if [[ ! -x .venv/bin/python ]]; then
      echo "projecthub: local Python environment is missing; run 'projecthub setup'" >&2
      exit 1
    fi
    if [[ ! -f frontend/dist/index.html ]]; then
      echo "projecthub: frontend build is missing; run 'projecthub setup'" >&2
      exit 1
    fi
    port="${PROJECTHUB_PORT:-8766}"
    echo "ProjectHub: http://127.0.0.1:${port}"
    echo "Press Ctrl+C to stop."
    exec .venv/bin/python -m uvicorn backend.app.main:create_app --factory --host 127.0.0.1 --port "$port"
    ;;
  check)
    cd "$project_root"
    exec bash scripts/check.sh
    ;;
  setup)
    cd "$project_root"
    exec bash scripts/setup.sh
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "projecthub: unknown command '$command_name'" >&2
    usage >&2
    exit 2
    ;;
esac
